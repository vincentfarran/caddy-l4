# Custom Caddy build for the Fast and Speed edges = Caddy v2.11.4 + mholt/caddy-l4 +
# caddy-dns/cloudflare.
#
# Pins were previously absent (`caddy:2-builder`, an unversioned caddy-l4), so every rebuild
# floated. They now match what Fast and Speed run today, read from `caddy build-info` on both
# hosts (2026-09-30): Caddy v2.11.4, caddy-l4 v0.1.2, certmagic v0.25.3, libdns v1.1.1.
#
# caddy-dns/cloudflare added for CHG-20260923-mesh-tls-wildcard (infra-ops): DNS-01 for
# <host>.mesh.snowboy.org / *.<host>.mesh.snowboy.org, delegated by an _acme-challenge CNAME to
# the dedicated 0nlyfan.org zone so the token never touches snowboy.org's own records. Same
# module and pin as caddy-sab-duck (NasSTY), proven there by a real issuance. The consuming
# caddy.json must set `override_domain` (dns_challenge_override_domain) to the CNAME target.
#
# Bump deliberately; never widen a pin to a floating tag.
FROM caddy:2.11.4-builder AS builder
RUN xcaddy build v2.11.4 \
    --with github.com/mholt/caddy-l4@v0.1.2 \
    --with github.com/caddy-dns/cloudflare@v0.2.4

FROM caddy:2.11.4-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
# Build-time gate: fail the build (before it is ever pushed) if the core drifted or a plugin
# did not compile in.
RUN caddy version | grep -q 'v2.11.4' \
    && caddy list-modules | grep -q '^layer4$' \
    && caddy list-modules | grep -q '^dns.providers.cloudflare$'
